# ---------------------------------------------------------------------------
# GateKeeper TS - environment configuration
# Copy this file to `.env` and adjust as needed.
# Values are validated at boot by src/lib/env.ts (Zod). Invalid values abort start-up.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port the API listens on.
PORT=4000

# Operating environment. Affects log verbosity and trust proxy behaviour.
NODE_ENV=development

# Comma-separated list of estate gate ids the platform knows about.
GATE_IDS=GATE-NORTH,GATE-SOUTH,GATE-VISITOR,GATE-SERVICE

# Default lifetime (in minutes) applied when an invitation does not specify one.
DEFAULT_INVITATION_TTL_MINUTES=120

# Default maximum number of uses for a freshly created invitation.
DEFAULT_INVITATION_MAX_USES=1

# Simulator: base URL of the API the hardware simulator should bombard.
SIMULATOR_BASE_URL=http://localhost:4000

# Simulator: delay (in milliseconds) between simulated gate scans.
SIMULATOR_INTERVAL_MS=4000
